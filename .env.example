# ---------- App ----------
# Public URL of the deployed app (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (free tier) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI provider ----------
# "gemini" (Google AI Studio free tier) or "ollama" (local, free)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only used when AI_PROVIDER=ollama. Must be reachable from where the code runs.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---------- LinkedIn (developer app, free) ----------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Products needed on the app: "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
LINKEDIN_API_VERSION=202604

# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---------- Optional free job APIs ----------
# https://developer.adzuna.com (free developer key, has India data)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# https://jooble.org/api/about (free key on request)
JOOBLE_API_KEY=

# ---------- Optional Telegram alerts (free) ----------
# Create a bot with @BotFather; put your chat id in Settings inside the app.
TELEGRAM_BOT_TOKEN=
